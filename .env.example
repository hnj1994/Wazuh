# ─────────────────────────────────────────────────────────────────────────────
# Helios AI SOC – Environment Configuration
# Azure VM public IP: 4.188.228.167  |  Ubuntu 22.04 LTS
#
# Usage:
#   cp .env.example .env
#   nano .env          # fill in real credentials
#
# ⚠  NEVER commit .env to version control.
# ⚠  VITE_* variables are compiled into the browser bundle — no secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# ── App identity ──────────────────────────────────────────────────────────────
VITE_APP_NAME="Helios AI SOC"

# ── Data mode ─────────────────────────────────────────────────────────────────
# false = live Wazuh / OpenSearch / Ollama  |  true = in-browser demo data
VITE_USE_MOCKS=false

# ── Browser-facing proxy paths (safe to expose – no credentials) ──────────────
VITE_WAZUH_PROXY_PATH=/api/wazuh
VITE_OPENSEARCH_PROXY_PATH=/api/opensearch
VITE_OLLAMA_PROXY_PATH=/api/ollama

# ── AI model ──────────────────────────────────────────────────────────────────
VITE_OLLAMA_MODEL=llama3.1:8b

# ── Default tenant ────────────────────────────────────────────────────────────
VITE_DEFAULT_TENANT=apex

# ── Live WebSocket alert stream ───────────────────────────────────────────────
# Leave empty to use the built-in demo alert stream (no BFF required).
# Set to  wss://4.188.228.167/ws/alerts  once a BFF is deployed.
VITE_WAZUH_WS_URL=

# ── Container port (host-facing) ──────────────────────────────────────────────
# The host nginx on port 443 proxies to this port.
HELIOS_SOC_PORT=8080

# ── Backend service URLs ───────────────────────────────────────────────────────
# host.docker.internal resolves to the Docker host on Linux via extra_hosts.
# Wazuh Manager (self-signed TLS, nginx does proxy_ssl_verify off)
WAZUH_BASE_URL=https://host.docker.internal:55000
# OpenSearch (Wazuh-managed, self-signed TLS)
OPENSEARCH_BASE_URL=https://host.docker.internal:9200
# Ollama (HTTP, loopback only – never expose this port in Azure NSG)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── OpenSearch credentials – server-side only ────────────────────────────────
# Nginx injects this as  Authorization: Basic <value>  so the browser never
# sees or sends OpenSearch credentials.
# Generate: echo -n "admin:YourStrongPassword" | base64
OPENSEARCH_BASIC_AUTH=YWRtaW46YWRtaW4=

# ── Future BFF WebSocket upstream ────────────────────────────────────────────
SOC_API_UPSTREAM=http://host.docker.internal:3001

# ── Local dev proxy only (not used in production Docker build) ────────────────
VITE_DEV_PORT=5173
VITE_WAZUH_BASE_URL=https://127.0.0.1:55000
VITE_OPENSEARCH_BASE_URL=https://127.0.0.1:9200
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
