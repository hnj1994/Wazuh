VITE_APP_NAME="Helios AI SOC"
VITE_USE_MOCKS=true
VITE_DEV_PORT=5173

# Browser-safe proxy routes. In production, point these to your API gateway/BFF, not directly to SIEM credentials.
VITE_WAZUH_PROXY_PATH=/api/wazuh
VITE_OPENSEARCH_PROXY_PATH=/api/opensearch
VITE_OLLAMA_PROXY_PATH=/api/ollama

# Used by vite dev proxy only.
VITE_WAZUH_BASE_URL=https://wazuh.example.local:55000
VITE_OPENSEARCH_BASE_URL=https://opensearch.example.local:9200
VITE_OLLAMA_BASE_URL=http://ollama.example.local:11434

# Optional live feed. Leave empty in mock mode to use the in-browser demo alert stream.
VITE_WAZUH_WS_URL=wss://soc-api.example.local/ws/alerts
VITE_OLLAMA_MODEL=llama3.1:8b
VITE_DEFAULT_TENANT=apex
