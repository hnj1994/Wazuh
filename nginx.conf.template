server {
  listen 80;
  server_name _;

  root  /usr/share/nginx/html;
  index index.html;

  # ── Compression ────────────────────────────────────────────────────────────
  gzip              on;
  gzip_vary         on;
  gzip_proxied      any;
  gzip_comp_level   6;
  gzip_buffers      16 8k;
  gzip_http_version 1.1;
  gzip_min_length   256;
  gzip_types
    application/javascript
    application/json
    application/xml
    image/svg+xml
    text/css
    text/plain;

  # ── Security headers (HSTS & full CSP are set by the host nginx layer) ─────
  add_header X-Frame-Options        "DENY"                            always;
  add_header X-Content-Type-Options "nosniff"                         always;
  add_header X-XSS-Protection       "1; mode=block"                   always;
  add_header Referrer-Policy        "strict-origin-when-cross-origin" always;

  # ── Health check ────────────────────────────────────────────────────────────
  location = /health {
    access_log   off;
    default_type application/json;
    return 200 '{"status":"ok","service":"helios-soc"}';
  }

  # ── React SPA ───────────────────────────────────────────────────────────────
  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-store, no-cache, must-revalidate" always;
  }

  # Immutable hashed assets (Vite fingerprints filenames at build time)
  location ~* \.(js|css|woff2?|png|jpg|jpeg|gif|ico|svg|webp)$ {
    try_files $uri =404;
    expires   365d;
    add_header Cache-Control "public, immutable";
    access_log off;
  }

  # ── Wazuh REST API ──────────────────────────────────────────────────────────
  # The browser sends  Authorization: Bearer <wazuh-jwt>  and it is forwarded
  # unchanged.  The JWT is obtained by the frontend via
  # POST /api/wazuh/security/user/authenticate (Basic auth) during login.
  location /api/wazuh/ {
    proxy_pass            ${WAZUH_BASE_URL}/;
    proxy_http_version    1.1;
    proxy_ssl_verify      off;                    # Wazuh uses a self-signed cert by default
    proxy_set_header      Host              $proxy_host;
    proxy_set_header      X-Real-IP         $remote_addr;
    proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header      X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout    60s;
    proxy_send_timeout    60s;
  }

  # ── OpenSearch ──────────────────────────────────────────────────────────────
  # Nginx injects Basic auth from OPENSEARCH_BASIC_AUTH env var so credentials
  # never leave the server.  Any Authorization header from the browser is
  # overridden here.
  location /api/opensearch/ {
    proxy_pass            ${OPENSEARCH_BASE_URL}/;
    proxy_http_version    1.1;
    proxy_ssl_verify      off;
    proxy_set_header      Host              $proxy_host;
    proxy_set_header      X-Real-IP         $remote_addr;
    proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header      Authorization     "Basic ${OPENSEARCH_BASIC_AUTH}";
    proxy_connect_timeout 10s;
    proxy_read_timeout    90s;
    proxy_send_timeout    90s;
  }

  # ── Ollama AI ───────────────────────────────────────────────────────────────
  # No upstream auth required.  proxy_buffering off allows streaming responses.
  location /api/ollama/ {
    proxy_pass            ${OLLAMA_BASE_URL}/;
    proxy_http_version    1.1;
    proxy_set_header      Host            $proxy_host;
    proxy_set_header      X-Real-IP       $remote_addr;
    proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_buffering       off;
    proxy_connect_timeout 10s;
    proxy_read_timeout    300s;   # AI generation can be slow
    proxy_send_timeout    300s;
  }

  # ── WebSocket – future BFF live-alert stream ────────────────────────────────
  location /ws/ {
    proxy_pass         ${SOC_API_UPSTREAM}/ws/;
    proxy_http_version 1.1;
    proxy_set_header   Upgrade    $http_upgrade;
    proxy_set_header   Connection "upgrade";
    proxy_set_header   Host       $host;
    proxy_set_header   X-Real-IP  $remote_addr;
    proxy_read_timeout  3600s;
    proxy_send_timeout  3600s;
  }
}
